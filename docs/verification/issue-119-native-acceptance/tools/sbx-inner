#!/bin/bash
# Runs as root inside fresh namespaces created by sbx-run; never invoke directly.
set -euo pipefail
FIX=$1; CWD=$2; shift 2
R="$FIX/.sbxroot"

ro_tree() {  # remount a mount point and every submount below it read-only
  findmnt -rn -o TARGET | awk -v p="$1" '$0==p || index($0, p"/")==1' | while read -r m; do
    mount -o remount,bind,ro "$m"
  done
}

mount --make-rprivate /
mount -t tmpfs -o mode=0755,size=16m sbxroot "$R"
mkdir -p "$R/usr" "$R/etc" "$R/proc" "$R/dev" "$R/tmp" "$R/oldroot"
mount -t tmpfs -o mode=1777,size=256m sbxtmp "$R/tmp"
mkdir -p "$R$FIX"
for d in usr etc; do mount --rbind "/$d" "$R/$d"; ro_tree "$R/$d"; done
ln -s usr/bin "$R/bin"; ln -s usr/lib "$R/lib"; ln -s usr/lib64 "$R/lib64"; ln -s usr/sbin "$R/sbin"
mount --bind "$FIX" "$R$FIX"; mount -o remount,bind,ro "$R$FIX"
for p in "$FIX/review-wt" "$FIX/owned-tmp"; do
  mount --bind "$p" "$R$p"; mount -o remount,bind,rw "$R$p"
done
mount --bind "$FIX/review-wt/.git" "$R$FIX/review-wt/.git"; mount -o remount,bind,ro "$R$FIX/review-wt/.git"
mount -t proc -o nosuid,nodev,noexec proc "$R/proc"
mount -t tmpfs -o mode=0755,size=1m sbxdev "$R/dev"
for n in null zero random urandom; do touch "$R/dev/$n"; mount --bind "/dev/$n" "$R/dev/$n"; done
cd "$R"
pivot_root . oldroot
umount -l /oldroot
rmdir /oldroot
mount -o remount,ro /
cd "$CWD"
exec /usr/bin/setpriv --no-new-privs --inh-caps=-all --ambient-caps=-all --bounding-set=-all -- \
  /usr/bin/env -i PATH=/usr/bin:/bin HOME="$FIX/home" TMPDIR="$FIX/owned-tmp" LANG=C.UTF-8 \
  PIP_NO_CACHE_DIR=1 PIP_CONFIG_FILE=/dev/null PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONNOUSERSITE=1 \
  "$@"
